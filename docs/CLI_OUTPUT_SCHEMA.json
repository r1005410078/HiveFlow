{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "文档目标：定义 CLI 输出机器校验合同。适用对象：CLI 开发、测试、CI 维护与审计系统接入方。",
  "$id": "https://hiveflow.local/schemas/cli-output.schema.json",
  "title": "HiveFlow CLI Output Envelope",
  "description": "Unified JSON envelope for HiveFlow CLI commands used by Skills.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command",
    "run_id",
    "status",
    "generated_at",
    "source",
    "advice_only",
    "decision_weight",
    "data",
    "warnings",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Envelope schema version using semver."
    },
    "command": {
      "type": "string",
      "minLength": 1,
      "description": "Fully qualified CLI command name, e.g. hf signal snapshot."
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "description": "Execution correlation id for audit tracing."
    },
    "status": {
      "type": "string",
      "enum": ["ok", "warning", "error"],
      "description": "Command execution status."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Output generation time in ISO-8601."
    },
    "source": {
      "type": "string",
      "enum": ["system", "news_system", "web_search"],
      "description": "Data source class for decision-tree semantics."
    },
    "advice_only": {
      "type": "boolean",
      "description": "Whether output is advisory only and must not affect executable branch."
    },
    "decision_weight": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Decision-tree numeric weight. web_search should use 0."
    },
    "data": {
      "type": ["object", "array", "string", "number", "boolean", "null"],
      "description": "Primary payload."
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/messageItem"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/errorItem"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "command": { "const": "hf data sync" }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "timeframe",
              "days",
              "end_date",
              "effective_symbols_count",
              "selection_mode",
              "symbols_hash",
              "manifest_ids"
            ],
            "properties": {
              "timeframe": { "type": "string", "enum": ["1d", "1m"] },
              "days": { "type": "integer", "minimum": 1 },
              "end_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
              "effective_symbols_count": { "type": "integer", "minimum": 0 },
              "selection_mode": { "type": "string", "enum": ["symbols", "universe", "default"] },
              "symbols_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "manifest_ids": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": { "const": "hf task list" }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["items"],
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "required": [
                    "run_id",
                    "date",
                    "status",
                    "timeframe",
                    "symbols_count",
                    "manifest_id"
                  ],
                  "properties": {
                    "run_id": { "type": "string", "minLength": 1 },
                    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
                    "status": { "type": "string", "enum": ["success", "failed", "running"] },
                    "timeframe": { "type": "string", "enum": ["1d", "1m"] },
                    "symbols_count": { "type": "integer", "minimum": 0 },
                    "manifest_id": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": { "const": "hf task progress" }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": true,
            "required": ["run_id", "status", "phase", "progress"],
            "properties": {
              "run_id": { "type": "string", "minLength": 1 },
              "status": { "type": "string" },
              "phase": { "type": "string" },
              "progress": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "total_symbols": { "type": "integer", "minimum": 0 },
                  "completed_symbols": { "type": "integer", "minimum": 0 },
                  "current_symbol": { "type": "string" },
                  "total_days": { "type": "integer", "minimum": 0 },
                  "completed_days": { "type": "integer", "minimum": 0 }
                }
              },
              "selection_mode": { "type": "string" },
              "end_date": { "type": "string" },
              "timeframe": { "type": "string" },
              "days": { "type": "integer" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": { "const": "hf data query" }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["items"],
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "required": [
                    "symbol",
                    "timeframe",
                    "bar_time",
                    "close"
                  ],
                  "properties": {
                    "symbol": { "type": "string", "minLength": 1 },
                    "timeframe": { "type": "string" },
                    "bar_time": { "type": "string", "minLength": 1 },
                    "close": { "type": "number" },
                    "open": { "type": "number" },
                    "high": { "type": "number" },
                    "low": { "type": "number" },
                    "volume": { "type": "number" }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": { "const": "web_search" }
        }
      },
      "then": {
        "properties": {
          "advice_only": { "const": true },
          "decision_weight": { "const": 0 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": { "const": "hf factor optimize" }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "factor_names",
              "analysis",
              "correlation_analysis",
              "top_combinations",
              "release_gate",
              "report",
              "recommendations"
            ],
            "properties": {
              "release_gate": {
                "type": "object",
                "required": ["status", "blocking_reasons", "watch_items"],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": ["pass", "watch", "fail"]
                  },
                  "blocking_reasons": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "watch_items": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                }
              },
              "report": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": { "const": "hf monitor health-report" }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": ["as_of"],
            "properties": {
              "as_of": { "type": "string" },
              "skipped": { "type": "boolean" },
              "skip_reason": { "type": ["string", "null"] },
              "overall_rating": {
                "oneOf": [
                  { "type": "null" },
                  { "type": "string", "enum": ["green", "yellow", "red"] }
                ]
              },
              "factor_health": {
                "oneOf": [{ "type": "null" }, { "type": "object" }]
              },
              "signal_health": {
                "oneOf": [{ "type": "null" }, { "type": "object" }]
              },
              "risk_health": {
                "oneOf": [{ "type": "null" }, { "type": "object" }]
              },
              "trend": { "type": "null" },
              "run_daily_warnings": { "type": "array" }
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": { "enum": ["system", "news_system"] }
        }
      },
      "then": {
        "properties": {
          "advice_only": { "const": false },
          "decision_weight": { "const": 1 }
        }
      }
    }
  ],
  "$defs": {
    "messageItem": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "errorItem": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 },
            "details": {}
          }
        }
      ]
    }
  }
}
